{
  "name": "disk-direct-mobile",
  "version": "3.1.6000",
  "description": "Mobile sub-project for Disk Direct using Capacitor",
  "scripts": {
    "sync": "cap sync && find android/app/src/main/assets/public ios/App/App/public \\( -name '*.gz' -o -name '*.br' \\) -delete",
    "open:android": "cap open android",
    "open:ios": "cap open ios",
    "build:android": "cap build android",
    "build:ios": "cap build ios"
  },
  "devDependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/cli": "^6.0.0",
    "@capacitor/ios": "^6.0.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@capacitor-community/apple-sign-in": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/push-notifications": "^6.0.5",
    "@capgo/capacitor-updater": "^6.4.0"
  }
}
